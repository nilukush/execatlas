# Copy to .env.local for local development. The site itself is fully static
# and needs no secrets. Ingestion flags live here too.

# Optional: disable a connector during ingestion (true = skip)
INGEST_DISABLE_WORKABLE=false
INGEST_DISABLE_ARBEITNOW=false
INGEST_DISABLE_JOBICY=false

# Polite crawler identity used by the ingestion pipeline
INGEST_CONTACT_EMAIL=

# Adzuna free Trial Access credentials (developer.adzuna.com); the source
# is skipped when these are unset
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
